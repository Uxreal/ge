<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application>
        <!--
            §4.1's public API. Exported and permission-free by design: any app, Tasker script or
            `adb shell am broadcast` can push a card. The launcher defends itself with validation,
            a 4-push/second per-package rate limit, a priority clamp at 500 so a third party can
            never outrank a call, and a user-managed block list — not with a permission wall.
        -->
        <receiver
            android:name=".push.CapsulePushReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="dev.lumen.launcher.capsule.PUSH" />
                <action android:name="dev.lumen.launcher.capsule.CLEAR" />
            </intent-filter>
        </receiver>

        <!--
            §4's media source needs a notification listener as its consent token: the system only
            reveals MediaSessions to a listener the user enabled by hand. Since D43 the listener
            also reads exactly one notification field - the posting package - to light icon dots;
            content never. Disabled it costs nothing and the launcher works fully without it (§10).
        -->
        <service
            android:name=".sources.CapsuleNotificationListener"
            android:exported="true"
            android:label="@string/capsule_media_access"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>
    </application>
</manifest>
